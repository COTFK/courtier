# Required: configure these for your S3-compatible storage.
S3_BUCKET=
S3_ENDPOINT=https://t3.storageapi.dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional: these values match the application defaults.
HOT_RELOAD=false
PORT=8000
DATABASE_PATH=cache.db

YAML_YUGI_ROOT=https://dawnbrandbots.github.io/yaml-yugi
YGOPRODECK_ROOT=https://db.ygoprodeck.com/api/v7
SYNC_COOLDOWN=PT12H
CARD_SCRIPTS_ARCHIVE=https://codeload.github.com/ProjectIgnis/CardScripts/tar.gz/refs/heads/master
CARD_SCRIPT_FOLDERS=["official","pre-release"]
CARD_IMAGES_ROOT=https://images.ygoprodeck.com/images/cards
CARD_THUMBNAILS_ROOT=https://images.ygoprodeck.com/images/cards_small
CARD_IMAGE_CONCURRENCY=8

S3_REGION=auto
S3_ADDRESSING_STYLE=virtual
S3_ALLOW_HTTP=false
